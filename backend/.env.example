# Rename this file to .env and fill in real values. Never commit the real .env file.

# OpenAI API key used by the LangGraph agents (router + answer generation) and
# for embeddings used by the RAG retriever.
#
# Mode is auto-detected from this value -- no separate flag to flip:
#   - Leave this unset, empty, or as the "sk-your-key-here" placeholder below,
#     and the app automatically runs in MOCK mode (no external API calls --
#     see USE_MOCK_LLM below for what that means).
#   - Set it to a real key, and the app automatically runs in REAL mode using
#     actual OpenAI calls.
# Either way, re-run `python -m app.rag.ingest` after changing this, since
# mock and real mode use separate, incompatible vector stores.
OPENAI_API_KEY=sk-your-key-here

# Chat/completion model used by the agents.
OPENAI_CHAT_MODEL=gpt-4o-mini

# Embedding model used to build and query the vector store.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Where the vector store is persisted on disk (real Chroma store, or the
# local mock store when running in mock mode).
CHROMA_PERSIST_DIR=./chroma_db

# Force mock or real mode regardless of whether OPENAI_API_KEY looks usable.
# Leave this unset in normal use -- auto-detection (above) is almost always
# what you want. Uncomment only to override it, e.g. to force mock mode for
# a quick local test even though a real key is configured.
# USE_MOCK_LLM=true

# Allowed origin(s) for CORS, comma-separated. The frontend is served by this
# same FastAPI app now, so this mainly matters if you open the HTML files from
# a different origin/port during development.
ALLOWED_ORIGINS=http://localhost:8000
